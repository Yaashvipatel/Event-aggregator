PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/campus_events
# Set to true to run with a throw-away in-memory MongoDB (no install needed, data lost on restart)
USE_MEMORY_DB=false
# Load demo users/events automatically when the database is empty
AUTO_SEED=true
# CHANGE THIS before deploying anywhere public
JWT_SECRET=dev-only-change-me-3f9a1c7e5b2d4a60
JWT_EXPIRES_IN=7d
RECOMMENDER_URL=http://127.0.0.1:5001
RECOMMENDER_TIMEOUT_MS=3000
REMINDER_WINDOW_MIN=60
AUTH_RATE_LIMIT=50
